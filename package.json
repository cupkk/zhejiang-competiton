{
  "name": "campus-growth-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "typecheck:frontend": "npm run typecheck --prefix frontend",
    "dev:api": "tsx watch server/index.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "start:api": "tsx server/index.ts",
    "seed:local": "tsx scripts/seed-local.ts",
    "test:security-routes": "tsx scripts/test-internal-routes.ts",
    "test:local-core": "tsx scripts/smoke-local-core.ts",
    "test:admin-content-security": "tsx scripts/smoke-admin-content-security.ts",
    "verify:local-release": "npm run lint && npm run typecheck:frontend && npm run test:security-routes && npm run test:local-core && npm run test:admin-content-security && npm run build:frontend",
    "lint": "tsc --noEmit",
    "sync:beta-content": "tsx scripts/sync-beta-content.ts",
    "approve:beta-content": "tsx scripts/approve-beta-content.ts",
    "sync:competition-news": "tsx scripts/sync-competition-news.ts",
    "sync:official-sources": "tsx scripts/sync-official-competition-sources.ts",
    "configure:team-showcase": "tsx scripts/configure-team-showcase.ts",
    "enrich:official-content": "tsx scripts/enrich-official-content.ts",
    "create:school-admin": "tsx scripts/create-school-admin.ts",
    "migrate:storage:s3": "tsx scripts/migrate-storage-to-s3.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.0",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2"
  }
}
