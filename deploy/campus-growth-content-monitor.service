[Unit]
Description=Campus Growth official content monitor
After=network-online.target campus-growth-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=campus
Group=campus
WorkingDirectory=/opt/campus-growth/current
EnvironmentFile=/etc/campus-growth/api.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/campus-growth/current/node_modules/.bin/tsx scripts/sync-official-competition-sources.ts --apply --confirm-production --limit=30
ExecStart=/opt/campus-growth/current/node_modules/.bin/tsx scripts/sync-competition-news.ts --apply --confirm-production --limit=8

[Install]
WantedBy=multi-user.target
