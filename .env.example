# Root API server
API_PORT=8080
API_BASE_PATH=/api
API_PUBLIC_ORIGIN=http://127.0.0.1:8080
DB_PATH=server/data/campus-growth.db
SESSION_TTL_DAYS=7
ADMIN_API_KEY=dev-admin-key

# WeChat mini program login
WECHAT_LOGIN_MODE=hybrid
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Local mock payment callback verification
WECHAT_PAY_NOTIFY_SECRET=

# WeChat Pay v3
WECHAT_PAY_MODE=hybrid
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_PLATFORM_SERIAL=

# Mini program runtime
TARO_APP_API_BASE_URL=http://127.0.0.1:8080/api
TARO_APP_PREFER_REMOTE=true
TARO_APP_ENABLE_MOCK_FALLBACK=true
